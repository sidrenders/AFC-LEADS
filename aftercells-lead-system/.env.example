# Aftercells Lead Management System - Airtable Configuration
#
# HOW TO GET THESE VALUES:
#
# 1. AIRTABLE_PERSONAL_ACCESS_TOKEN
#    - Go to: https://airtable.com/create/tokens
#    - Click "Create new token"
#    - Name it: "Aftercells Lead System"
#    - Scopes: data.records:read, data.records:write, schema.bases:read, schema.bases:write
#    - Access: Select your workspace
#    - Copy the token (starts with "pat.")
#
# 2. AIRTABLE_BASE_ID
#    - Create a new base in Airtable (or use an existing empty one)
#    - Open the base
#    - Look at the URL: https://airtable.com/appXXXXXXXXXXXXXX/...
#    - The part starting with "app" is your base ID
#

AIRTABLE_PERSONAL_ACCESS_TOKEN=pat.your_token_here
AIRTABLE_BASE_ID=appYourBaseIdHere

# YouTube Data API v3 (free - for Stage 1 auto-filter)
# Get one at: https://console.cloud.google.com/ → Enable YouTube Data API v3 → Credentials → API Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Anthropic Claude API (for Stage 2 AI classification)
# Get one at: https://console.anthropic.com/ → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-your_key_here
