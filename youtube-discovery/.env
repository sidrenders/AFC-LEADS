# YouTube Discovery - Environment Variables

# YouTube Data API Key (FREE - get from Google Cloud Console)
# 1. Go to https://console.cloud.google.com/
# 2. Create a project
# 3. Enable "YouTube Data API v3"
# 4. Create credentials -> API Key
YOUTUBE_API_KEY=your_api_key_here

# Database (SQLite by default - no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./data/discovery.db

# Rate limiting (be respectful to YouTube)
REQUESTS_PER_MINUTE=30
SCRAPE_DELAY_SECONDS=2
